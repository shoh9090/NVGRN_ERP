<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Бот HoReCa — <%= settings.company_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Manrope:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css">
  <style>
    :root { --brand: <%= settings.brand_color || '#2E7D32' %>; }
    .wrap { max-width: 860px; margin: 0 auto; padding: 24px; }
    .card { background:#fff; border:1px solid #e3e3e3; border-radius:12px; padding:20px 24px; margin-top:16px; }
    .steps { line-height:1.7; }
    .btn-dl, .btn-go { display:inline-block; background:var(--brand); color:#fff; text-decoration:none; border:none; cursor:pointer;
              padding:12px 20px; border-radius:8px; font-weight:600; margin-top:8px; font-size:15px; }
    .muted { color:#666; }
    .note { background:#f6f8f6; border-left:4px solid var(--brand); padding:10px 14px; border-radius:6px; margin-top:14px; }
    .banner { padding:12px 16px; border-radius:8px; margin-top:16px; }
    .banner.err { background:#fff2f2; border-left:4px solid #d33; color:#a11; }
    .banner.ok  { background:#f1f8f1; border-left:4px solid var(--brand); }
    .warn { background:#fff8e6; border-left:4px solid #e0a800; padding:10px 14px; border-radius:6px; margin-top:12px; }
    table { width:100%; border-collapse:collapse; margin-top:12px; font-size:14px; }
    th,td { text-align:left; padding:6px 8px; border-bottom:1px solid #eee; }
    th { color:#555; font-weight:600; }
    ul.compact { margin:8px 0 0; padding-left:20px; line-height:1.6; }
    .stat { display:inline-block; margin-right:18px; }
    .stat b { font-size:20px; color:var(--brand); }
    input[type=file] { margin-top:8px; }

    /* ===== Модалка «Telegram-агенты» в стиле счёт-фактур ===== */
    .tgm-iconrow{display:flex;gap:10px;align-items:center;margin:16px 0 6px;flex-wrap:wrap}
    .tgm-icon{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;border-radius:11px;color:#52605a;background:#fbfaf4;border:1px solid #e6e2d6;transition:.18s;cursor:pointer;text-decoration:none}
    .tgm-icon:hover{background:#f0ede3;color:#14241b}
    .tgm-icon svg{width:19px;height:19px;display:block}
    .tgm-overlay{display:none;position:fixed;inset:0;background:rgba(16,42,29,.45);z-index:100;align-items:center;justify-content:center;padding:20px}
    .tgm-overlay.on{display:flex}
    .tgm-modal{background:#f4f2ea;border-radius:18px;width:100%;max-width:900px;max-height:92vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 30px 80px -20px rgba(16,42,29,.6)}
    .tgm-hd{display:flex;align-items:center;gap:14px;padding:16px 20px;background:#fff;border-bottom:1px solid #e6e2d6}
    .tgm-t{font-family:'Lora',serif;font-size:18px;font-weight:600;color:#14241b}
    .tgm-s{font-size:12px;color:#8a958f;font-weight:600}
    .tgm-body{padding:20px 22px;overflow:auto;background:#f4f2ea}
    .tgm-ft{display:flex;gap:10px;align-items:center;padding:14px 20px;border-top:1px solid #e6e2d6;background:#fff;flex-wrap:wrap}
    .tgm-ft .grow{flex:1}
    .tgm-btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:13.5px;padding:10px 18px;border-radius:11px;transition:.16s;cursor:pointer;border:none;font-family:inherit}
    .tgm-blue{background:#2f6fb0;color:#fff}.tgm-blue:hover{filter:brightness(1.06)}
    .tgm-green{background:linear-gradient(180deg,#9ad24f,#6aa82f);color:#10260a}.tgm-green:hover{filter:brightness(1.05)}
    .tgm-ghost{background:#fff;border:1px solid #e6e2d6;color:#52605a}.tgm-ghost:hover{background:#f0ede3}
    .tgm-modal table{width:100%;border-collapse:collapse;font-size:13px;background:#fff;border-radius:12px;overflow:hidden}
    .tgm-modal th{text-transform:uppercase;font-size:11px;letter-spacing:.4px;color:#8a958f;font-weight:700;text-align:left;padding:11px 12px;border-bottom:1px solid #e6e2d6;background:#fbfaf4}
    .tgm-modal td{padding:10px 12px;border-bottom:1px solid #efece2;vertical-align:top}
    .tgm-chip{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:700;padding:5px 11px;border-radius:30px;border:1px solid #e6e2d6;background:#fbfaf4;color:#8a958f}
    .tgm-chip .d{width:7px;height:7px;border-radius:50%;background:#b9b9b9}
    .tgm-chip.on{background:#eef6df;color:#3f6a16;border-color:#d3e8b4}
    .tgm-chip.on .d{background:#6aa82f;box-shadow:0 0 0 3px rgba(140,198,63,.2)}
    .tgm-chip.off{background:#f3f3f3;color:#999}
    .tgm-modal select,.tgm-modal input[type=text]{font-family:inherit;font-size:13px;padding:6px 9px;border:1px solid #e6e2d6;border-radius:8px;background:#fff}
    .tgm-modal select:focus,.tgm-modal input:focus{outline:none;border-color:#6aa82f;box-shadow:0 0 0 3px rgba(140,198,63,.18)}
    .tgm-rowform{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
    .tgm-sm{padding:5px 11px;font-size:12.5px;border-radius:8px;font-weight:700;cursor:pointer;border:1px solid #e6e2d6;background:#fff}
    .tgm-sm.go{background:#163a28;color:#fff;border-color:#163a28}
    .tgm-sm.danger{color:#b5462c;border-color:#e6c2b8;background:#fff}
    .tgm-note{font-size:12.5px;color:#52605a;margin-bottom:14px;line-height:1.55}
    .tgm-bn{padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:13px}
    .tgm-bn.ok{background:#eef6df;border-left:4px solid #6aa82f;color:#3f6a16}
    .tgm-bn.err{background:#fbece5;border-left:4px solid #c0492f;color:#a53d24}
    .tgm-add{margin-top:18px;padding-top:14px;border-top:1px dashed #d8d3c4}
    .tgm-btn svg{width:16px;height:16px}
    .tgm-trash{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;border-radius:8px;border:1px solid #e6e2d6;background:#fff;color:#b5462c;cursor:pointer}
    .tgm-trash:hover{background:#fbece5;border-color:#e6c2b8}
    .tgm-assign{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:0}
    .tgm-assign select{min-width:118px}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-left">
      <% if (settings.logo_file_id) { %><img class="topbar-logo" src="/file/<%= settings.logo_file_id %>" alt=""><% } %>
      <span class="company"><%= settings.company_name %></span>
    </div>
    <div class="topbar-right"><a class="btn-ghost" href="/">← На главную</a></div>
  </header>

  <main class="wrap">
    <h2>Бот HoReCa — контакты для напоминаний</h2>
    <p class="muted">Список номеров, по которым Telegram-бот узнаёт завскладов точек и менеджеров сетей.</p>
    <div class="tgm-iconrow">
      <a class="tgm-icon" href="/tgbot/analytics" title="Аналитика по агентам (АКБ/ОКБ)"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="12" width="4.2" height="8" rx="1.2"/><rect x="9.9" y="6" width="4.2" height="14" rx="1.2"/><rect x="16.8" y="3" width="4.2" height="17" rx="1.2"/></svg></a>
      <button class="tgm-icon" id="openStaff" type="button" title="Telegram-агенты (сотрудники и роли)"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M9.04 15.47 8.7 20.2c.49 0 .7-.21.96-.46l2.3-2.2 4.77 3.49c.87.48 1.5.23 1.73-.81l3.14-14.7c.28-1.3-.47-1.81-1.32-1.5L2.2 9.6c-1.27.5-1.25 1.2-.22 1.52l4.7 1.46L17.6 6.1c.5-.33.96-.15.58.18L9.04 15.47z"/></svg></button>
    </div>

    <% if (error) { %><div class="banner err"><%= error %></div><% } %>
    <% if (result) { %>
      <div class="banner ok">
        Сохранено. Точек: <b><%= result.points %></b>, менеджеров сетей: <b><%= result.managers %></b>.
      </div>
    <% } %>

    <!-- Настройки напоминаний (РОП) -->
    <div class="card">
      <h3>Настройки напоминаний</h3>
      <% if (settingsSaved) { %><div class="banner ok">Настройки сохранены. Бот применит их в течение минуты.</div><% } %>
      <form method="POST" action="/tgbot/settings">
        <p>Времена напоминаний (через запятую, по Ташкенту):<br>
          <input type="text" name="reminder_times" value="<%= botSettings.reminder_times %>" style="width:260px" placeholder="18:00,21:00,23:00"></p>
        <p>Дедлайн — после этого времени не напоминать:<br>
          <input type="text" name="deadline" value="<%= botSettings.deadline %>" style="width:120px" placeholder="00:00"></p>
        <p>Окно усреднения заказа (дней):<br>
          <input type="number" name="avg_window_days" min="1" max="60" value="<%= botSettings.avg_window_days %>" style="width:90px"></p>
        <p><label><input type="checkbox" name="enabled" <%= botSettings.enabled ? 'checked' : '' %>> Напоминания включены</label></p>
        <button class="btn-go" type="submit">Сохранить настройки</button>
      </form>
      <div class="note">Формат времени — ЧЧ:ММ. Заказ сегодня → доставка завтра. Дедлайн 00:00 = без отдельного ограничения, напоминают только в указанные времена.</div>
    </div>

    <!-- Шаг 1 -->
    <div class="card">
      <h3>Шаг 1. Скачать форму</h3>
      <p class="steps">Форма заполнена всеми активными HoReCa-точками. Агентам нужно вписать два номера: телефон завсклада (по точке) и телефон менеджера сети (по контрагенту).</p>
      <a class="btn-dl" href="/tgbot/export">⬇ Скачать форму (Excel)</a>
      <div class="note">Столбец <b>SD_id</b> не трогать. Номер менеджера сети у всех точек одного контрагента одинаковый — бот сам схлопнет в одну сводку.</div>
    </div>

    <!-- Шаг 2 -->
    <div class="card">
      <h3>Шаг 2. Загрузить заполненную форму</h3>
      <form method="POST" action="/tgbot/import" enctype="multipart/form-data">
        <input type="file" name="file" accept=".xlsx,.xls" required>
        <br>
        <button class="btn-go" type="submit">Проверить файл</button>
      </form>
      <p class="muted" style="margin-top:10px;">Сначала покажу, что получится, — сохранение только после подтверждения.</p>
    </div>

    <!-- Превью -->
    <% if (preview) { %>
      <div class="card">
        <h3>Предпросмотр</h3>
        <div>
          <span class="stat">Строк в файле: <b><%= preview.summary.totalRows %></b></span>
          <span class="stat">Точек к записи: <b><%= preview.summary.validPoints %></b></span>
          <span class="stat">С номером завсклада: <b><%= preview.summary.withZavsklad %></b></span>
          <span class="stat">Менеджеров сетей: <b><%= preview.summary.managers %></b></span>
        </div>

        <% if (preview.errors.length) { %>
          <div class="warn">
            Пропущено строк: <%= preview.errors.length %> (нет SD_id или ИНН).
            <ul class="compact"><% preview.errors.slice(0,15).forEach(function(e){ %><li><%= e %></li><% }) %></ul>
            <% if (preview.errors.length > 15) { %><div class="muted">…и ещё <%= preview.errors.length - 15 %></div><% } %>
          </div>
        <% } %>

        <% if (preview.conflicts.length) { %>
          <div class="warn">
            Конфликты номеров менеджера:
            <ul class="compact"><% preview.conflicts.forEach(function(c){ %><li><%= c %></li><% }) %></ul>
          </div>
        <% } %>

        <% if (preview.sample.length) { %>
          <table>
            <tr><th>Точка</th><th>Контрагент</th><th>ИНН</th><th>Завсклад</th><th>Менеджер сети</th></tr>
            <% preview.sample.forEach(function(r){ %>
              <tr>
                <td><%= r.point_name %></td>
                <td><%= r.firm_name %></td>
                <td><%= r.inn %></td>
                <td><%= r.zavsklad_phone || '—' %></td>
                <td><%= r.manager_phone || '—' %></td>
              </tr>
            <% }) %>
          </table>
          <% if (preview.summary.validPoints > preview.sample.length) { %>
            <p class="muted">Показаны первые <%= preview.sample.length %> из <%= preview.summary.validPoints %>.</p>
          <% } %>
        <% } %>

        <form method="POST" action="/tgbot/import/commit" style="margin-top:16px;">
          <input type="hidden" name="payload" value="<%= preview.payload %>">
          <button class="btn-go" type="submit">✓ Подтвердить и сохранить</button>
        </form>
      </div>
    <% } %>
  </main>

  <!-- Модалка «Telegram-агенты» -->
  <div class="tgm-overlay <%= openStaff ? 'on' : '' %>" id="staffOverlay">
    <div class="tgm-modal">
      <div class="tgm-hd">
        <div style="flex:1"><div class="tgm-t">Telegram-агенты</div><div class="tgm-s">Заявки на доступ к боту и подтверждённые сотрудники</div></div>
        <button class="tgm-icon" data-close-staff type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="tgm-body">
        <% if (staffMsg) { %><div class="tgm-bn ok"><%= staffMsg %></div><% } %>
        <% if (staffErr) { %><div class="tgm-bn err"><%= staffErr %></div><% } %>
        <div class="tgm-note">Сначала нажмите <b>«Загрузить агентов из CRM»</b> — программа подтянет список из SalesDoctor. Когда сотрудник пишет боту и делится номером, он <b>сам привязывается по телефону</b>. Если автопривязки нет — выберите агента из списка вручную и нажмите «Подтвердить».</div>
        <table>
          <thead><tr><th>Телефон</th><th>Имя в Telegram</th><th>Агент в CRM (имя/код) и роль</th><th>Статус</th><th></th></tr></thead>
          <tbody>
            <% if (!staff.length) { %>
              <tr><td colspan="5" class="tgm-note" style="margin:0">Пока нет ни заявок, ни подтверждённых сотрудников. Нажмите «Загрузить агентов из CRM», затем пусть сотрудник напишет боту и поделится номером.</td></tr>
            <% } %>
            <% staff.forEach(function(s){
                 var tgname=[s.telegram_first_name,s.telegram_last_name].filter(Boolean).join(' ')+(s.telegram_username?' (@'+s.telegram_username+')':'');
                 var on=s.status==='confirmed';
            %>
            <tr>
              <td><%= s.phone_original||s.phone_normalized||'—' %></td>
              <td><%= tgname||'—' %></td>
              <td>
                <form method="POST" action="/tgbot/staff/assign" class="tgm-assign">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <select name="crm_agent_id" onchange="this.form.submit()">
                    <option value="">— не привязан —</option>
                    <% agents.forEach(function(a){ %><option value="<%= a.sd_agent_id %>" <%= s.crm_agent_id===a.sd_agent_id?'selected':'' %>><%= a.sd_agent_name %><%= a.sd_agent_code?(' / '+a.sd_agent_code):'' %></option><% }); %>
                  </select>
                  <select name="role" onchange="this.form.submit()" title="Роль">
                    <option value="agent" <%= s.role==='agent'?'selected':'' %>>Агент</option>
                    <option value="head_of_sales" <%= s.role==='head_of_sales'?'selected':'' %>>Руководитель</option>
                    <option value="admin" <%= s.role==='admin'?'selected':'' %>>Админ</option>
                  </select>
                </form>
              </td>
              <td><span class="tgm-chip <%= on?'on':'' %>"><span class="d"></span><%= on?'подтверждён':'ожидает' %></span></td>
              <td style="text-align:right">
                <form method="POST" action="/tgbot/staff/delete" onsubmit="return confirm('Удалить сотрудника из списка?')">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <button class="tgm-trash" type="submit" title="Удалить"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <div class="tgm-add">
          <div class="tgm-t" style="font-size:14px">Добавить вручную (РОП / админ)</div>
          <div class="tgm-note" style="margin:4px 0 8px">Для тех, кого нет среди агентов SalesDoctor. Затем пусть напишет боту и поделится номером.</div>
          <form method="POST" action="/tgbot/staff/add-manual" class="tgm-rowform">
            <input type="text" name="name" placeholder="ФИО" style="width:190px" required>
            <input type="text" name="phone" placeholder="998.." style="width:150px" required>
            <select name="role"><option value="head_of_sales">Руководитель</option><option value="admin">Админ</option><option value="agent">Агент</option></select>
            <button class="tgm-sm go" type="submit">Добавить</button>
          </form>
        </div>
      </div>
      <div class="tgm-ft">
        <form method="POST" action="/tgbot/staff/load-agents"><button class="tgm-btn tgm-blue" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v4h-4"/></svg> Загрузить агентов из CRM</button></form>
        <a class="tgm-btn tgm-ghost" href="/tgbot?staff=1">Обновить</a>
        <% var syncTxt='',syncOn=false; if (typeof syncedAt!=='undefined' && syncedAt){ var sd2=new Date(syncedAt); syncOn=(Date.now()-sd2.getTime())<3*3600000; syncTxt=sd2.toLocaleString('ru-RU',{timeZone:'Asia/Tashkent',hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit'}); } %>
        <span class="tgm-chip <%= syncOn?'on':'' %>" title="Клиенты синхронизируются автоматически каждые ~45 минут"><span class="d"></span><%= syncedAt ? ('Синхронизировано · '+syncTxt) : 'Ещё не синхронизировано' %></span>
        <div class="grow"></div>
        <button class="tgm-btn tgm-ghost" data-close-staff type="button">Закрыть</button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      var ov=document.getElementById('staffOverlay');
      var open=document.getElementById('openStaff');
      if(open) open.addEventListener('click',function(){ov.classList.add('on');});
      Array.prototype.forEach.call(document.querySelectorAll('[data-close-staff]'),function(b){b.addEventListener('click',function(){ov.classList.remove('on');});});
      ov.addEventListener('click',function(e){if(e.target===ov)ov.classList.remove('on');});
      document.addEventListener('keydown',function(e){if(e.key==='Escape')ov.classList.remove('on');});
    })();
  </script>
</body>
</html>
