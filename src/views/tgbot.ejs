<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Телеграм-бот: ассистент продаж — <%= settings.company_name %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com"><link href="https://fonts.googleapis.com/css2?family=Lora:wght@500;600&family=Manrope:wght@600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/static/style.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/tabs.css?v=<%= V %>">
  <style>
    :root { --brand: <%= settings.brand_color || '#2E7D32' %>; }
    .wrap { max-width: 860px; margin: 0 auto; padding: 24px; }
    .card { background:#fff; border:1px solid #e3e3e3; border-radius:12px; padding:20px 24px; margin-top:16px; }
    .steps { line-height:1.7; }
    .btn-dl, .btn-go { display:inline-block; background:var(--brand); color:#fff; text-decoration:none; border:none; cursor:pointer;
              padding:12px 20px; border-radius:8px; font-weight:600; margin-top:8px; font-size:15px; }
    .muted { color:#666; }
    .note { background:#f6f8f6; border-left:4px solid var(--brand); padding:10px 14px; border-radius:6px; margin-top:14px; }
    .banner { padding:12px 16px; border-radius:8px; margin-top:16px; }
    .banner.err { background:#fff2f2; border-left:4px solid #d33; color:#a11; }
    .banner.ok  { background:#f1f8f1; border-left:4px solid var(--brand); }
    .warn { background:#fff8e6; border-left:4px solid #e0a800; padding:10px 14px; border-radius:6px; margin-top:12px; }
    table { width:100%; border-collapse:collapse; margin-top:12px; font-size:14px; }
    th,td { text-align:left; padding:6px 8px; border-bottom:1px solid #eee; }
    th { color:#555; font-weight:600; }
    ul.compact { margin:8px 0 0; padding-left:20px; line-height:1.6; }
    .stat { display:inline-block; margin-right:18px; }
    .stat b { font-size:20px; color:var(--brand); }
    input[type=file] { margin-top:8px; }

    /* ===== Модалка «Telegram-агенты» в стиле счёт-фактур ===== */
    .tgm-iconrow{display:flex;gap:10px;align-items:center;margin:16px 0 6px;flex-wrap:wrap}
    .tgm-icon{display:inline-flex;align-items:center;justify-content:center;width:40px;height:40px;padding:0;flex:none;border-radius:11px;color:#52605a;background:#fbfaf4;border:1px solid #e6e2d6;transition:.18s;cursor:pointer;text-decoration:none}
    .tgm-icon:hover{background:#f0ede3;color:#14241b}
    .tgm-icon svg{width:19px;height:19px;display:block}
    .tgm-overlay{display:none;position:fixed;inset:0;background:rgba(16,42,29,.45);z-index:100;align-items:center;justify-content:center;padding:20px}
    .tgm-overlay.on{display:flex}
    .tgm-modal{background:#f4f2ea;border-radius:18px;width:100%;max-width:900px;max-height:92vh;overflow:hidden;display:flex;flex-direction:column;box-shadow:0 30px 80px -20px rgba(16,42,29,.6)}
    .tgm-hd{display:flex;align-items:center;gap:14px;padding:16px 20px;background:#fff;border-bottom:1px solid #e6e2d6}
    .tgm-t{font-family:'Lora',serif;font-size:18px;font-weight:600;color:#14241b}
    .tgm-s{font-size:12px;color:#8a958f;font-weight:600}
    .tgm-body{padding:20px 22px;overflow:auto;background:#f4f2ea}
    .tgm-ft{display:flex;gap:10px;align-items:center;padding:14px 20px;border-top:1px solid #e6e2d6;background:#fff;flex-wrap:wrap}
    .tgm-ft .grow{flex:1}
    .tgm-btn{display:inline-flex;align-items:center;gap:8px;font-weight:700;font-size:13.5px;padding:10px 18px;border-radius:11px;transition:.16s;cursor:pointer;border:none;font-family:inherit;text-decoration:none}
    .tgm-blue{background:#2f6fb0;color:#fff}.tgm-blue:hover{filter:brightness(1.06)}
    .tgm-green{background:linear-gradient(180deg,#9ad24f,#6aa82f);color:#10260a}.tgm-green:hover{filter:brightness(1.05)}
    .tgm-ghost{background:#fff;border:1px solid #e6e2d6;color:#52605a}.tgm-ghost:hover{background:#f0ede3}
    .tgm-modal table{width:100%;border-collapse:collapse;font-size:13px;background:#fff;border-radius:12px;overflow:hidden}
    .tgm-modal th{text-transform:uppercase;font-size:11px;letter-spacing:.4px;color:#8a958f;font-weight:700;text-align:left;padding:11px 12px;border-bottom:1px solid #e6e2d6;background:#fbfaf4}
    .tgm-modal td{padding:10px 12px;border-bottom:1px solid #efece2;vertical-align:top}
    .tgm-chip{display:inline-flex;align-items:center;gap:7px;font-size:11.5px;font-weight:700;padding:5px 11px;border-radius:30px;border:1px solid #e6e2d6;background:#fbfaf4;color:#8a958f}
    .tgm-chip .d{width:7px;height:7px;border-radius:50%;background:#b9b9b9}
    .tgm-chip.on{background:#eef6df;color:#3f6a16;border-color:#d3e8b4}
    .tgm-chip.on .d{background:#6aa82f;box-shadow:0 0 0 3px rgba(140,198,63,.2)}
    .tgm-chip.off{background:#f3f3f3;color:#999}
    .tgm-modal select,.tgm-modal input[type=text]{font-family:inherit;font-size:13px;padding:6px 9px;border:1px solid #e6e2d6;border-radius:8px;background:#fff}
    .tgm-modal select:focus,.tgm-modal input:focus{outline:none;border-color:#6aa82f;box-shadow:0 0 0 3px rgba(140,198,63,.18)}
    .tgm-rowform{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
    .tgm-sm{padding:5px 11px;font-size:12.5px;border-radius:8px;font-weight:700;cursor:pointer;border:1px solid #e6e2d6;background:#fff}
    .tgm-sm.go{background:#163a28;color:#fff;border-color:#163a28}
    .tgm-sm.danger{color:#b5462c;border-color:#e6c2b8;background:#fff}
    .tgm-note{font-size:12.5px;color:#52605a;margin-bottom:14px;line-height:1.55}
    .tgm-tabs{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px}
    .tgm-tab{border:1px solid #e6e2d6;background:#fbfaf4;color:#52605a;border-radius:30px;padding:6px 14px;font-size:12.5px;font-weight:700;cursor:pointer}
    .tgm-tab.on{background:#163a28;color:#fff;border-color:#163a28}
    .tgm-subs{width:100%;border-collapse:collapse;margin-top:8px;font-size:13px}
    .tgm-subs th,.tgm-subs td{border:1px solid #e6e2d6;padding:7px 10px}
    .tgm-subs th{background:#fbfaf4;color:#52605a;font-size:12px}
    .tgm-subs td:first-child{font-weight:600;color:#163a28}
    .tgm-bn{padding:10px 14px;border-radius:8px;margin-bottom:14px;font-size:13px}
    .tgm-bn.ok{background:#eef6df;border-left:4px solid #6aa82f;color:#3f6a16}
    .tgm-bn.err{background:#fbece5;border-left:4px solid #c0492f;color:#a53d24}
    .tgm-add{margin-top:18px;padding-top:14px;border-top:1px dashed #d8d3c4}
    .tgm-btn svg{width:16px;height:16px}
    .tgm-trash{display:inline-flex;align-items:center;justify-content:center;width:30px;height:30px;padding:0;flex:none;border-radius:8px;border:1px solid #e6e2d6;background:#fff;color:#b5462c;cursor:pointer}
    .tgm-trash:hover{background:#fbece5;border-color:#e6c2b8}
    .tgm-assign{display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin:0}
    .tgm-assign select{min-width:118px}

    .tgm-iconrow .grow{flex:1}
    .tgm-rem{display:flex;flex-direction:column;gap:8px;margin-bottom:16px}
    .tgm-remrow{display:flex;align-items:center;justify-content:space-between;gap:14px;font-size:13.5px;color:#14241b}
    .tgm-remrow span{color:#52605a}
    .tgm-remrow input[type=time],.tgm-remrow input[type=number]{font-family:inherit;font-size:14px;padding:7px 10px;border:1px solid #e6e2d6;border-radius:9px;background:#fff}
    .tgm-remrow input:focus{outline:none;border-color:#6aa82f;box-shadow:0 0 0 3px rgba(140,198,63,.18)}
    .tgm-fields{display:flex;flex-direction:column;gap:10px;border-top:1px dashed #d8d3c4;padding-top:14px}
    .tgm-check{display:flex;align-items:center;gap:8px;font-size:13.5px;color:#14241b;font-weight:600}
    .tgm-step{background:#fff;border:1px solid #e6e2d6;border-radius:12px;padding:14px 16px;margin-bottom:12px}
    .tgm-step .tgm-note{margin:6px 0 10px}
    .tgm-modal table.tgm-prev{font-size:12px}
    .tgm-warn{background:#fff7e8;border-left:4px solid #e0a93f;color:#7a5a17;padding:8px 12px;border-radius:8px;font-size:12.5px;margin:10px 0}
    .tgm-stat{display:inline-block;margin-right:14px;font-size:12.5px;color:#52605a}
  </style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-left">
      <a href="/" title="На главную Hub" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:inherit;cursor:pointer">
        <% if (settings.logo_file_id) { %><img class="topbar-logo" src="/file/<%= settings.logo_file_id %>" alt=""><% } %>
        <span class="company"><%= settings.company_name %></span>
      </a>
    </div>
    <div class="topbar-right"><a class="btn-ghost" href="/">← На главную</a></div>
  </header>

  <main class="wrap">
    <h2>Телеграм-бот: ассистент продаж</h2>
    <p class="muted">Заказы, претензии, напоминания и отчёты для отдела продаж. Здесь — контакты точек и менеджеров, по которым бот узнаёт завскладов и агентов.</p>
    <% var syncTxt='',syncOn=false; if (typeof syncedAt!=='undefined' && syncedAt){ var sd0=new Date(syncedAt); syncOn=(Date.now()-sd0.getTime())<3*3600000; syncTxt=sd0.toLocaleString('ru-RU',{timeZone:'Asia/Tashkent',hour:'2-digit',minute:'2-digit',day:'2-digit',month:'2-digit'}); } %>
    <div class="tgm-iconrow">
      <a class="tgm-icon" href="/tgbot/analytics" title="Аналитика по агентам (АКБ/ОКБ)"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><rect x="3" y="12" width="4.2" height="8" rx="1.2"/><rect x="9.9" y="6" width="4.2" height="14" rx="1.2"/><rect x="16.8" y="3" width="4.2" height="17" rx="1.2"/></svg></a>
      <a class="tgm-icon" href="/tgbot/lost-sales" title="Упущенные продажи (склад урезал заказ)"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7l6 6 4-4 8 8"/><path d="M21 17v-5h-5"/></svg></a>
      <button class="tgm-icon" id="openStaff" type="button" title="Telegram-агенты (сотрудники и роли)"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M9.04 15.47 8.7 20.2c.49 0 .7-.21.96-.46l2.3-2.2 4.77 3.49c.87.48 1.5.23 1.73-.81l3.14-14.7c.28-1.3-.47-1.81-1.32-1.5L2.2 9.6c-1.27.5-1.25 1.2-.22 1.52l4.7 1.46L17.6 6.1c.5-.33.96-.15.58.18L9.04 15.47z"/></svg></button>
      <button class="tgm-icon" id="openSettings" type="button" title="Настройки напоминаний клиента"><svg width="19" height="19" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a6 6 0 0 0-6 6c0 4-1.4 5.4-2 6.2-.4.5 0 .9.5.9h15c.5 0 .9-.4.5-.9-.6-.8-2-2.2-2-6.2a6 6 0 0 0-6-6zm-2 18a2 2 0 0 0 4 0z"/></svg></button>
      <button class="tgm-icon" id="openAgent" type="button" title="Сводки и сигналы для торговой команды"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4h6v2.5H9z"/><path d="M8.5 11h7M8.5 15h5"/></svg></button>
      <a class="tgm-icon" href="/tgbot?repl=1" title="Замены товара (нет в наличии → предложить замену)"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 7h13l-3-3M4 7l3 3M20 17H7l3 3M20 17l-3-3"/></svg></a>
      <button class="tgm-icon" id="openImport" type="button" title="Excel-форма контактов (резервная загрузка)"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-6.7-3M3 12a9 9 0 0 1 9-9 9 9 0 0 1 6.7 3"/><path d="M21 3v5h-5M3 21v-5h5"/></svg></button>
      <span class="grow"></span>
      <span class="tgm-chip <%= syncOn?'on':'' %>" title="CRM синхронизируется автоматически: агенты и клиенты"><span class="d"></span><%= syncedAt ? ('CRM синхронизирована · '+syncTxt) : 'CRM ещё не синхронизирована' %></span>
    </div>

  </main>

  <!-- Модалка «Сводки и сигналы» -->
  <div class="tgm-overlay <%= openAgent ? 'on' : '' %>" id="agentOverlay">
    <div class="tgm-modal" style="max-width:560px">
      <div class="tgm-hd">
        <div style="flex:1"><div class="tgm-t">Настройки оповещений</div><div class="tgm-s">Сводки и сигналы · доставка · кто что получает</div></div>
        <button class="tgm-icon" data-close-agent type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="tgm-body">
        <% if (settingsSaved && openAgent) { %><div class="tgm-bn ok">Сохранено. Бот применит в течение минуты.</div><% } %>
        <% if (typeof error!=='undefined' && error && openAgent) { %><div class="tgm-bn err"><%= error %></div><% } %>
        <div class="tgm-tabs" id="setTabs">
          <button type="button" class="tgm-tab on" data-p="digest">📊 Сводки и сигналы</button>
          <button type="button" class="tgm-tab" data-p="delivery">🚚 Доставка</button>
          <button type="button" class="tgm-tab" data-p="notif">🔔 Оповещения</button>
        </div>
        <div class="tgm-pane" data-pane="digest">
        <form method="POST" action="/tgbot/settings/agent" id="agentForm">
          <div class="tgm-fields">
            <label class="tgm-remrow"><span>Сводка агенту — время</span><input type="time" name="digest_time" value="<%= botSettings.digest_time||'08:30' %>"></label>
            <label class="tgm-check"><input type="checkbox" name="digest_enabled" <%= botSettings.digest_enabled!==false?'checked':'' %>> Слать утреннюю сводку агентам</label>
          </div>
          <div class="tgm-fields" style="margin-top:14px">
            <label class="tgm-check"><input type="checkbox" name="signals_enabled" <%= botSettings.signals_enabled!==false?'checked':'' %>> Слать сигналы спада / отвала</label>
            <label class="tgm-remrow"><span>Сигнал 1: нет заказов N дней</span><input type="number" name="signal1_days" min="1" max="30" value="<%= botSettings.signal1_days||3 %>"></label>
            <label class="tgm-remrow"><span>Сигнал 2: падение суммы ≥ %</span><input type="number" name="signal2_pct" min="5" max="95" value="<%= botSettings.signal2_pct||40 %>"></label>
            <label class="tgm-remrow"><span>Сигнал 2: окно сравнения (дней)</span><input type="number" name="signal2_window" min="3" max="30" value="<%= botSettings.signal2_window||7 %>"></label>
          </div>
          <div class="tgm-fields" style="margin-top:14px">
            <label class="tgm-check"><input type="checkbox" name="order_alerts_enabled" <%= botSettings.order_alerts_enabled!==false?'checked':'' %>> Оповещать об изменениях заказов на складе (упущения/правки)</label>
            <label class="tgm-remrow"><span>Тихий час: не слать с</span><input type="time" name="quiet_from" value="<%= botSettings.quiet_from||'22:00' %>"></label>
            <label class="tgm-remrow"><span>Тихий час: до</span><input type="time" name="quiet_to" value="<%= botSettings.quiet_to||'08:00' %>"></label>
            <label class="tgm-remrow"><span>Сводка упущенных РОПу/админу</span>
              <select name="lost_summary_freq">
                <option value="off" <%= botSettings.lost_summary_freq==='off'?'selected':'' %>>Выключить</option>
                <option value="daily" <%= botSettings.lost_summary_freq==='daily'?'selected':'' %>>Ежедневно</option>
                <option value="weekly" <%= (botSettings.lost_summary_freq||'weekly')==='weekly'?'selected':'' %>>Еженедельно</option>
              </select>
            </label>
          </div>
        </form>
        <div class="tgm-note" style="margin-top:12px">Сводка приходит каждому агенту в указанное время по его клиентам. Сигналы — не чаще раза в день на клиента. В тихий час оповещения об изменениях заказов не отправляются (данные всё равно копятся для дашборда).</div>
        <button class="tgm-btn tgm-green" type="submit" form="agentForm" style="margin-top:12px">Сохранить</button>
        </div>

        <div class="tgm-pane" data-pane="delivery" style="display:none">
        <div class="tgm-t" style="font-size:14px">🚚 Напоминания водителям о доставке</div>
        <form method="POST" action="/tgbot/settings/delivery" id="deliveryForm">
          <div class="tgm-fields" style="margin-top:8px">
            <label class="tgm-check"><input type="checkbox" name="delivery_remind_enabled" <%= botSettings.delivery_remind_enabled!==false?'checked':'' %>> Напоминать водителям о недоставленных заказах</label>
            <label class="tgm-remrow"><span>Время напоминаний (через запятую)</span><input type="text" name="delivery_remind_times" value="<%= botSettings.delivery_remind_times||'21:00,22:00' %>" placeholder="21:00,22:00"></label>
          </div>
        </form>
        <div class="tgm-note" style="margin-top:8px">Заказ «Отгружен», но не отмечен «Доставлен» и дата доставки уже наступила → в это время бот напомнит водителю. Логист видит сводку по кнопке «По экспедиторам».</div>
        <button class="tgm-btn tgm-green" type="submit" form="deliveryForm" style="margin-top:12px">Сохранить</button>
        </div>

        <div class="tgm-pane" data-pane="notif" style="display:none">
        <div class="tgm-t" style="font-size:14px">🔔 Кто получает оповещения</div>
        <form method="POST" action="/tgbot/settings/notif-subs" id="notifSubsForm">
          <table class="tgm-subs">
            <thead><tr><th>Тип оповещения</th><% notifRoles.forEach(function(r){ %><th><%= r.label %></th><% }); %></tr></thead>
            <tbody>
              <% notifKinds.forEach(function(k){ %>
              <tr>
                <td><%= k.label %></td>
                <% notifRoles.forEach(function(r){ %>
                <td style="text-align:center"><input type="checkbox" name="sub_<%= k.kind %>_<%= r.role %>" <%= notifSubs[k.kind+'|'+r.role]?'checked':'' %>></td>
                <% }); %>
              </tr>
              <% }); %>
            </tbody>
          </table>
        </form>
        <div class="tgm-note" style="margin-top:6px">Отметьте, какие роли получают какой тип. Напр. добавьте «Логистика» в правки заказа или снимите «Админ», если ему это не нужно. Свои клиентские оповещения агент получает всегда.</div>
        <button class="tgm-btn tgm-green" type="submit" form="notifSubsForm" style="margin-top:12px">Сохранить</button>
        </div>
        <script>
          (function(){
            var t=document.getElementById('setTabs'); if(!t) return;
            t.querySelectorAll('.tgm-tab').forEach(function(b){ b.addEventListener('click',function(){
              var p=b.getAttribute('data-p');
              document.querySelectorAll('#agentOverlay .tgm-pane').forEach(function(pn){ pn.style.display = pn.getAttribute('data-pane')===p?'':'none'; });
              t.querySelectorAll('.tgm-tab').forEach(function(x){ x.classList.toggle('on', x===b); });
            }); });
          })();
        </script>
      </div>
      <div class="tgm-ft">
        <div class="grow"></div>
        <button class="tgm-btn tgm-ghost" data-close-agent type="button">Закрыть</button>
      </div>
    </div>
  </div>

  <!-- Модалка «Замены товара» -->
  <div class="tgm-overlay <%= openRepl ? 'on' : '' %>" id="replOverlay">
    <div class="tgm-modal" style="max-width:680px">
      <div class="tgm-hd">
        <div style="flex:1"><div class="tgm-t">Замены товара</div><div class="tgm-s">Нет в наличии → бот предложит замену (не подставляет сам)</div></div>
        <button class="tgm-icon" data-close-repl type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="tgm-body">
        <% if (typeof msg!=='undefined' && msg && openRepl) { %><div class="tgm-bn ok"><%= msg %></div><% } %>
        <% if (typeof err!=='undefined' && err && openRepl) { %><div class="tgm-bn err"><%= err %></div><% } %>
        <div class="tgm-step">
          <div class="tgm-t" style="font-size:14px">Добавить замену</div>
          <% if (!products.length) { %><div class="tgm-note">Список товаров не загрузился. Нажмите иконку «Замены товара» ещё раз.</div><% } %>
          <form method="POST" action="/tgbot/replacements/add" class="tgm-rowform" style="margin-top:8px">
            <select name="product_sd_id" required style="max-width:240px"><option value="">— которого нет —</option><% products.forEach(function(pr){ %><option value="<%= pr.SD_id %>"><%= pr.name %></option><% }) %></select>
            <span style="font-weight:700">→</span>
            <select name="replacement_sd_id" required style="max-width:240px"><option value="">— заменить на —</option><% products.forEach(function(pr){ %><option value="<%= pr.SD_id %>"><%= pr.name %></option><% }) %></select>
            <button class="tgm-sm go" type="submit">Добавить</button>
          </form>
        </div>
        <table>
          <thead><tr><th>Нет в наличии</th><th>Замена</th><th></th></tr></thead>
          <tbody>
            <% if (!replacements.length) { %><tr><td colspan="3" class="tgm-note" style="margin:0">Замен пока нет. Добавьте первую — бот будет предлагать её, когда товара нет на складе.</td></tr><% } %>
            <% replacements.forEach(function(rp){ %>
            <tr>
              <td><%= rp.product_name || rp.product_sd_id %></td>
              <td>→ <%= rp.replacement_name || rp.replacement_sd_id %></td>
              <td style="text-align:right">
                <form method="POST" action="/tgbot/replacements/delete" onsubmit="return confirm('Удалить замену?')">
                  <input type="hidden" name="id" value="<%= rp.id %>">
                  <button class="tgm-trash" type="submit" title="Удалить"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
                </form>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="tgm-ft"><div class="grow"></div><button class="tgm-btn tgm-ghost" data-close-repl type="button">Закрыть</button></div>
    </div>
  </div>

  <!-- Модалка «Настройки напоминаний» -->
  <div class="tgm-overlay <%= openSettings ? 'on' : '' %>" id="settingsOverlay">
    <div class="tgm-modal" style="max-width:560px">
      <div class="tgm-hd">
        <div style="flex:1"><div class="tgm-t">Настройки напоминаний клиента</div><div class="tgm-s">Во сколько бот напоминает завскладам (по Ташкенту). Галочка — включить напоминание.</div></div>
        <button class="tgm-icon" data-close-settings type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="tgm-body">
        <% if (settingsSaved) { %><div class="tgm-bn ok">Сохранено. Бот применит в течение минуты.</div><% } %>
        <% if (typeof error!=='undefined' && error && openSettings) { %><div class="tgm-bn err"><%= error %></div><% } %>
        <% var slots=(botSettings.reminder_times||'').split(',').map(function(x){return x.trim();}).filter(Boolean); %>
        <form method="POST" action="/tgbot/settings" id="remForm">
          <div class="tgm-rem">
            <% for (var i=0;i<5;i++){ %>
              <label class="tgm-remrow"><span>Напоминание <%= i+1 %></span><span style="display:flex;align-items:center;gap:10px"><input type="checkbox" name="reminder_on_<%= i+1 %>" <%= slots[i] ? 'checked' : '' %> title="Включить это напоминание"><input type="time" name="reminder_<%= i+1 %>" value="<%= slots[i]||'' %>"></span></label>
            <% } %>
          </div>
          <div class="tgm-fields">
            <label class="tgm-remrow"><span>Дедлайн — после не напоминать</span><input type="time" name="deadline" value="<%= botSettings.deadline||'00:00' %>"></label>
            <label class="tgm-remrow"><span>Окно усреднения заказа (дней)</span><input type="number" name="avg_window_days" min="1" max="60" value="<%= botSettings.avg_window_days %>"></label>
            <label class="tgm-check"><input type="checkbox" name="enabled" <%= botSettings.enabled ? 'checked' : '' %>> Напоминания включены</label>
          </div>
        </form>
        <div class="tgm-note" style="margin-top:12px">Снимите галочку — напоминание отключится (можно оставить 2 или 1). Заказ сегодня → доставка завтра.</div>
      </div>
      <div class="tgm-ft">
        <button class="tgm-btn tgm-green" type="submit" form="remForm">Сохранить</button>
        <div class="grow"></div>
        <button class="tgm-btn tgm-ghost" data-close-settings type="button">Закрыть</button>
      </div>
    </div>
  </div>

  <!-- Модалка «Excel-форма контактов» (резерв) -->
  <div class="tgm-overlay <%= openImport ? 'on' : '' %>" id="importOverlay">
    <div class="tgm-modal" style="max-width:780px">
      <div class="tgm-hd">
        <div style="flex:1"><div class="tgm-t">Excel-форма контактов</div><div class="tgm-s">Резервная загрузка — обычно клиенты приходят из SD автоматически</div></div>
        <button class="tgm-icon" data-close-import type="button"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="tgm-body">
        <% if (result) { %><div class="tgm-bn ok">Сохранено. Точек: <b><%= result.points %></b>, менеджеров сетей: <b><%= result.managers %></b>.</div><% } %>
        <% if (typeof error!=='undefined' && error && openImport) { %><div class="tgm-bn err"><%= error %></div><% } %>
        <div class="tgm-step">
          <div class="tgm-t" style="font-size:14px">Шаг 1. Скачать форму</div>
          <div class="tgm-note">Форма заполнена активными HoReCa-точками. Агентам вписать телефон завсклада (по точке) и телефон менеджера сети (по контрагенту). Столбец <b>SD_id</b> не трогать.</div>
          <a class="tgm-btn tgm-green" href="/tgbot/export"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3v12M8 11l4 4 4-4M5 21h14"/></svg> Скачать форму (Excel)</a>
        </div>
        <div class="tgm-step">
          <div class="tgm-t" style="font-size:14px">Шаг 2. Загрузить заполненную</div>
          <form method="POST" action="/tgbot/import" enctype="multipart/form-data" class="tgm-rowform" style="margin-top:8px">
            <input type="file" name="file" accept=".xlsx,.xls" required>
            <button class="tgm-btn tgm-blue" type="submit">Проверить файл</button>
          </form>
          <div class="tgm-note">Сначала покажу превью — сохранение только после подтверждения.</div>
        </div>
        <% if (preview) { %>
          <div class="tgm-step">
            <div class="tgm-t" style="font-size:14px">Предпросмотр</div>
            <div style="margin:8px 0">
              <span class="tgm-stat">Строк: <b><%= preview.summary.totalRows %></b></span>
              <span class="tgm-stat">К записи: <b><%= preview.summary.validPoints %></b></span>
              <span class="tgm-stat">С завскладом: <b><%= preview.summary.withZavsklad %></b></span>
              <span class="tgm-stat">Менеджеров: <b><%= preview.summary.managers %></b></span>
            </div>
            <% if (preview.errors.length) { %><div class="tgm-warn">Пропущено строк: <%= preview.errors.length %> (нет SD_id или ИНН).</div><% } %>
            <% if (preview.conflicts.length) { %><div class="tgm-warn">Конфликты номеров менеджера: <%= preview.conflicts.length %> — возьму первый.</div><% } %>
            <% if (preview.sample.length) { %>
              <table class="tgm-prev"><thead><tr><th>Точка</th><th>Контрагент</th><th>ИНН</th><th>Завсклад</th><th>Менеджер</th></tr></thead><tbody>
                <% preview.sample.forEach(function(r){ %><tr><td><%= r.point_name %></td><td><%= r.firm_name %></td><td><%= r.inn %></td><td><%= r.zavsklad_phone || '—' %></td><td><%= r.manager_phone || '—' %></td></tr><% }) %>
              </tbody></table>
              <% if (preview.summary.validPoints > preview.sample.length) { %><div class="tgm-note">Показаны первые <%= preview.sample.length %> из <%= preview.summary.validPoints %>.</div><% } %>
            <% } %>
            <form method="POST" action="/tgbot/import/commit" style="margin-top:14px">
              <input type="hidden" name="payload" value="<%= preview.payload %>">
              <button class="tgm-btn tgm-green" type="submit">✓ Подтвердить и сохранить</button>
            </form>
          </div>
        <% } %>
      </div>
      <div class="tgm-ft"><div class="grow"></div><button class="tgm-btn tgm-ghost" data-close-import type="button">Закрыть</button></div>
    </div>
  </div>

  <!-- Модалка «Telegram-агенты» -->
  <div class="tgm-overlay <%= openStaff ? 'on' : '' %>" id="staffOverlay">
    <div class="tgm-modal">
      <div class="tgm-hd">
        <div style="flex:1"><div class="tgm-t">Telegram-сотрудники</div><div class="tgm-s">Заявки на доступ к боту и подтверждённые сотрудники</div></div>
        <button class="tgm-icon" data-close-staff type="button"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
      </div>
      <div class="tgm-body">
        <% if (staffMsg) { %><div class="tgm-bn ok"><%= staffMsg %></div><% } %>
        <% if (staffErr) { %><div class="tgm-bn err"><%= staffErr %></div><% } %>
        <div class="tgm-note">Нажмите <b>«Загрузить агентов»</b> и <b>«Загрузить экспедиторов»</b> — подтянутся списки из SalesDoctor. Сотрудников заводит только админ: добавьте вручную (ФИО, телефон, роль) или, для агента/водителя, выберите из списка. Затем сотрудник пишет боту и делится номером — доступ откроется по телефону. Неизвестные номера доступа не получают.</div>
        <div class="tgm-tabs" id="staffTabs">
          <button type="button" class="tgm-tab on" data-f="all">Все</button>
          <button type="button" class="tgm-tab" data-f="agent">Агенты</button>
          <button type="button" class="tgm-tab" data-f="expeditor">Экспедиторы</button>
          <button type="button" class="tgm-tab" data-f="other">Прочие (РОП/логистика/др.)</button>
        </div>
        <table>
          <thead><tr><th>Телефон</th><th>Имя в Telegram</th><th>Агент в CRM (имя/код) и роль</th><th>Статус</th><th></th></tr></thead>
          <tbody>
            <% if (!staff.length) { %>
              <tr><td colspan="5" class="tgm-note" style="margin:0">Пока нет ни заявок, ни подтверждённых сотрудников. Нажмите «Загрузить агентов из CRM», затем пусть сотрудник напишет боту и поделится номером.</td></tr>
            <% } %>
            <% staff.forEach(function(s){
                 var tgname=[s.telegram_first_name,s.telegram_last_name].filter(Boolean).join(' ')+(s.telegram_username?' (@'+s.telegram_username+')':'');
                 var on=s.status==='confirmed';
                 var grp = s.role==='agent'?'agent':(s.role==='expeditor'?'expeditor':'other');
            %>
            <tr data-grp="<%= grp %>">
              <td><%= s.phone_original||s.phone_normalized||'—' %></td>
              <td><%= tgname||'—' %></td>
              <td>
                <form method="POST" action="/tgbot/staff/assign" class="tgm-assign">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <select name="role" onchange="this.form.submit()" title="Роль">
                    <option value="agent" <%= s.role==='agent'?'selected':'' %>>Агент</option>
                    <option value="head_of_sales" <%= s.role==='head_of_sales'?'selected':'' %>>Руководитель продаж</option>
                    <option value="logistics" <%= s.role==='logistics'?'selected':'' %>>Логистика</option>
                    <option value="expeditor" <%= s.role==='expeditor'?'selected':'' %>>Экспедитор</option>
                    <option value="marketing" <%= s.role==='marketing'?'selected':'' %>>Маркетинг</option>
                    <option value="admin" <%= s.role==='admin'?'selected':'' %>>Админ</option>
                  </select>
                  <% if (!s.role || s.role==='agent') { %>
                    <select name="crm_agent_id" onchange="this.form.submit()" title="Агент CRM">
                      <option value="">— выберите агента CRM —</option>
                      <% agents.forEach(function(a){ %><option value="<%= a.sd_agent_id %>" <%= s.crm_agent_id===a.sd_agent_id?'selected':'' %>><%= a.sd_agent_name %><%= a.sd_agent_code?(' / '+a.sd_agent_code):'' %></option><% }); %>
                    </select>
                  <% } else if (s.role==='expeditor') { %>
                    <select name="expeditor_sd_id" onchange="this.form.submit()" title="Экспедитор SD">
                      <option value="">— выберите водителя SD —</option>
                      <% (typeof expeditors!=='undefined'?expeditors:[]).forEach(function(e){ %><option value="<%= e.sd_id %>" <%= s.expeditor_sd_id===e.sd_id?'selected':'' %>><%= e.name %><%= e.phone_normalized?(' · '+e.phone_normalized):'' %></option><% }); %>
                    </select>
                  <% } %>
                </form>
              </td>
              <td><span class="tgm-chip <%= on?'on':'' %>"><span class="d"></span><%= on?'подтверждён':'ожидает' %></span></td>
              <td style="text-align:right">
                <form method="POST" action="/tgbot/staff/delete" onsubmit="return confirm('Удалить сотрудника из списка?')">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <button class="tgm-trash" type="submit" title="Удалить"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14"/></svg></button>
                </form>
              </td>
            </tr>
            <% }); %>
          </tbody>
        </table>
        <script>
          (function(){
            var tabs=document.getElementById('staffTabs'); if(!tabs) return;
            function apply(f){
              document.querySelectorAll('#staffOverlay tbody tr[data-grp]').forEach(function(tr){
                tr.style.display = (f==='all'||tr.getAttribute('data-grp')===f)?'':'none';
              });
              tabs.querySelectorAll('.tgm-tab').forEach(function(b){ b.classList.toggle('on', b.getAttribute('data-f')===f); });
            }
            tabs.querySelectorAll('.tgm-tab').forEach(function(b){ b.addEventListener('click',function(){ apply(b.getAttribute('data-f')); }); });
          })();
        </script>
        <div class="tgm-add">
          <div class="tgm-t" style="font-size:14px">Добавить сотрудника</div>
          <div class="tgm-note" style="margin:4px 0 8px">Выберите роль. Для агента/водителя выберите его из списка (у водителя ФИО и телефон подставятся из SD). Для РОПа/логистики/маркетинга/админа — впишите ФИО и телефон.</div>
          <form method="POST" action="/tgbot/staff/add-manual" class="tgm-rowform" id="addStaffForm">
            <select name="role" id="addRole" onchange="addStaffToggle()">
              <option value="head_of_sales">Руководитель продаж</option>
              <option value="logistics">Логистика</option>
              <option value="marketing">Маркетинг</option>
              <option value="admin">Админ</option>
              <option value="agent">Агент</option>
              <option value="expeditor">Экспедитор (водитель)</option>
            </select>
            <select name="expeditor_sd_id" id="addExp" style="display:none">
              <option value="">— выберите водителя SD —</option>
              <% (typeof expeditors!=='undefined'?expeditors:[]).forEach(function(e){ %><option value="<%= e.sd_id %>"><%= e.name %><%= e.phone_normalized?(' · '+e.phone_normalized):'' %></option><% }); %>
            </select>
            <select name="crm_agent_id" id="addAgent" style="display:none">
              <option value="">— выберите агента CRM —</option>
              <% agents.forEach(function(a){ %><option value="<%= a.sd_agent_id %>"><%= a.sd_agent_name %><%= a.sd_agent_code?(' / '+a.sd_agent_code):'' %></option><% }); %>
            </select>
            <input type="text" name="name" id="addName" placeholder="ФИО" style="width:180px">
            <input type="text" name="phone" id="addPhone" placeholder="998.." style="width:120px">
            <button class="tgm-sm go" type="submit">Добавить</button>
          </form>
          <script>
            function addStaffToggle(){
              var r=document.getElementById('addRole').value;
              document.getElementById('addExp').style.display = r==='expeditor'?'':'none';
              document.getElementById('addAgent').style.display = r==='agent'?'':'none';
              // водителю ФИО/телефон подставятся из SD — поля можно скрыть
              var manual = (r!=='expeditor');
              document.getElementById('addName').style.display = manual?'':'none';
              document.getElementById('addPhone').style.display = manual?'':'none';
            }
            addStaffToggle();
          </script>
        </div>
      </div>
      <div class="tgm-ft">
        <form method="POST" action="/tgbot/staff/load-agents"><button class="tgm-btn tgm-blue" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v4h-4"/></svg> Загрузить агентов</button></form>
        <form method="POST" action="/tgbot/staff/load-expeditors"><button class="tgm-btn tgm-blue" type="submit"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7M21 4v4h-4"/></svg> Загрузить экспедиторов</button></form>
        <a class="tgm-btn tgm-ghost" href="/tgbot?staff=1">Обновить</a>
        <div class="grow"></div>
        <button class="tgm-btn tgm-ghost" data-close-staff type="button">Закрыть</button>
      </div>
    </div>
  </div>

  <script>
    (function(){
      function wire(ovId, openId, closeAttr){
        var ov=document.getElementById(ovId); if(!ov) return;
        var op=openId?document.getElementById(openId):null;
        if(op) op.addEventListener('click',function(){ov.classList.add('on');});
        Array.prototype.forEach.call(document.querySelectorAll('['+closeAttr+']'),function(b){b.addEventListener('click',function(){ov.classList.remove('on');});});
        ov.addEventListener('click',function(e){if(e.target===ov)ov.classList.remove('on');});
      }
      wire('staffOverlay','openStaff','data-close-staff');
      wire('settingsOverlay','openSettings','data-close-settings');
      wire('importOverlay','openImport','data-close-import');
      wire('agentOverlay','openAgent','data-close-agent');
      wire('replOverlay',null,'data-close-repl');
      document.addEventListener('keydown',function(e){if(e.key==='Escape'){['staffOverlay','settingsOverlay','importOverlay','agentOverlay','replOverlay'].forEach(function(id){var o=document.getElementById(id);if(o)o.classList.remove('on');});}});
    })();
  </script>
</body>
</html>
