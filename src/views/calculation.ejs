<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Калькуляция себестоимости — <%= settings.company_name %></title>
  <link rel="stylesheet" href="/static/style.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/calculation.css?v=<%= V %>">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Lora:wght@500;600&display=swap" rel="stylesheet">
  <style>:root { --brand: <%= settings.brand_color || '#163a28' %>; }</style>
</head>
<body class="admin-body">
  <header class="topbar admin-topbar">
    <div class="topbar-left">
      <a href="/" class="btn-ghost" title="На главную Hub">← На главную</a>
      <a href="/" style="display:inline-flex;align-items:center;gap:10px;text-decoration:none;color:inherit">
        <% if (settings.logo_file_id) { %><img class="topbar-logo" src="/file/<%= settings.logo_file_id %>" alt=""><% } %>
        <span class="company">🧮 Калькуляция себестоимости</span>
      </a>
      <span id="calc-mode-badge" class="calc-mode-badge"></span>
    </div>
    <div class="topbar-right">
      <div id="bell-root" class="bell-root"></div>
      <span style="font-size:13px; font-weight:700"><%= user.name %></span>
    </div>
  </header>

  <main id="calc-main"></main>
  <div id="calc-modal-root"></div>

  <script>window.HUB_USER = { isAdmin: <%= user.isAdmin ? "true" : "false" %>, isFinance: <%= user.isFinance ? "true" : "false" %>, name: "<%= user.name %>" };</script>
  <script src="/static/bell.js?v=<%= V %>"></script>
  <script src="/static/calculation.js?v=<%= V %>"></script>
</body>
</html>
