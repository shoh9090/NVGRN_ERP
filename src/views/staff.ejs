<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Telegram-агенты — <%= settings.company_name %></title>
  <link rel="stylesheet" href="/static/style.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/tabs.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/filters.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/chips.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/conn.css?v=<%= V %>">
  <style>
    :root { --brand: <%= settings.brand_color || '#2E7D32' %>; }
    .wrap { max-width: 1080px; margin: 0 auto; padding: 24px; }
    .card { background:#fff; border:1px solid #e3e3e3; border-radius:12px; padding:20px 24px; margin-top:16px; }
    .muted { color:#666; }
    .note { background:#f6f8f6; border-left:4px solid var(--brand); padding:10px 14px; border-radius:6px; margin-top:8px; }
    .banner { padding:12px 16px; border-radius:8px; margin-top:16px; }
    .banner.err { background:#fff2f2; border-left:4px solid #d33; color:#a11; }
    .banner.ok  { background:#f1f8f1; border-left:4px solid var(--brand); }
    .btn-go, button.btn-go { display:inline-block; background:var(--brand); color:#fff; text-decoration:none; border:none; cursor:pointer;
              padding:10px 16px; border-radius:8px; font-weight:600; font-size:14px; }
    .btn-sm { padding:5px 10px; font-size:13px; border-radius:6px; border:1px solid #ccc; background:#fff; cursor:pointer; }
    .btn-sm.danger { color:#a11; border-color:#e3b3b3; }
    table { width:100%; border-collapse:collapse; margin-top:12px; font-size:13px; }
    th,td { text-align:left; padding:8px 10px; border-bottom:1px solid #eee; vertical-align:top; }
    th { color:#555; font-weight:600; }
    .tag { display:inline-block; padding:2px 8px; border-radius:20px; font-size:12px; font-weight:600; }
    .tag.new { background:#fff3d6; color:#8a6d00; }
    .tag.ok { background:#e3f4e6; color:#1f7a33; }
    .tag.off { background:#eee; color:#777; }
    select, input[type=text] { padding:5px 8px; border:1px solid #ccc; border-radius:6px; font-size:13px; }
    .rowform { display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
    .actions-bar { display:flex; gap:10px; flex-wrap:wrap; margin-top:10px; }
  </style>
</head>
<body>
  <%- include('partials/topbar', { title: '👤 Сотрудники бота', backHref: '/tgbot', backText: 'К ассистенту продаж' }) %>

  <main class="wrap">
    <h2>Telegram-агенты</h2>
    <p class="muted">Заявки на доступ к боту и подтверждённые сотрудники.</p>
    <div class="note">Сначала нажмите «Загрузить агентов из CRM» — программа подтянет список из SalesDoctor. Когда сотрудник пишет боту и делится номером, он привязывается по телефону автоматически. Если автопривязки нет — выберите агента из списка вручную и нажмите «Подтвердить».</div>

    <% if (msg) { %><div class="banner ok"><%= msg %></div><% } %>
    <% if (err) { %><div class="banner err"><%= err %></div><% } %>

    <div class="card">
      <div class="actions-bar">
        <form method="POST" action="/tgbot/staff/load-agents"><button class="btn-go" type="submit">Загрузить агентов из CRM</button></form>
        <form method="POST" action="/tgbot/staff/load-expeditors"><button class="btn-go" type="submit">Загрузить экспедиторов из CRM</button></form>
        <form method="POST" action="/tgbot/staff/sync-clients"><button class="btn-go" type="submit">Синхронизировать клиентов</button></form>
        <a class="btn-ghost" href="/tgbot/staff">Обновить</a>
      </div>
      <p class="muted" style="margin-top:10px">Агентов в справочнике: <%= agents.length %> · Экспедиторов: <%= (typeof expeditors!=='undefined'?expeditors.length:0) %></p>
    </div>

    <div class="card">
      <h3>Добавить вручную (РОП / админ)</h3>
      <p class="muted">Для руководителя продаж и админа, которых может не быть среди агентов SalesDoctor.</p>
      <p class="muted">Для РОПа/логистики/маркетинга/админа. Для водителя выберите его в «экспедитор SD» — имя и телефон подставятся из CRM.</p>
      <form method="POST" action="/tgbot/staff/add-manual" class="rowform">
        <input type="text" name="name" placeholder="ФИО (для водителя можно пусто)" style="width:200px">
        <input type="text" name="phone" placeholder="Телефон (998..)" style="width:160px">
        <select name="role">
          <option value="head_of_sales">Руководитель продаж</option>
          <option value="logistics">Логистика (руководитель)</option>
          <option value="expeditor">Экспедитор (водитель)</option>
          <option value="marketing">Маркетинг</option>
          <option value="admin">Админ</option>
          <option value="agent">Агент</option>
        </select>
        <select name="expeditor_sd_id">
          <option value="">— экспедитор SD (для водителя) —</option>
          <% (typeof expeditors!=='undefined'?expeditors:[]).forEach(function(e){ %>
            <option value="<%= e.sd_id %>"><%= e.name %><%= e.phone_normalized ? ' · '+e.phone_normalized : '' %></option>
          <% }); %>
        </select>
        <button class="btn-go" type="submit">Добавить</button>
      </form>
    </div>

    <div class="card">
      <h3>Сотрудники и заявки</h3>
      <table>
        <thead>
          <tr><th>Телефон</th><th>Имя в Telegram</th><th>Агент в CRM</th><th>Роль</th><th>Статус</th><th>Действия</th></tr>
        </thead>
        <tbody>
          <% if (!staff.length) { %>
            <tr><td colspan="6" class="muted">Пока нет ни заявок, ни подтверждённых сотрудников.</td></tr>
          <% } %>
          <% staff.forEach(function(s){
               var tgname = [s.telegram_first_name, s.telegram_last_name].filter(Boolean).join(' ') + (s.telegram_username ? ' (@'+s.telegram_username+')' : '');
               var st = s.status;
               var tagcls = st==='confirmed' ? 'ok' : (st==='disabled'||st==='rejected' ? 'off' : 'new');
          %>
          <tr>
            <td><%= s.phone_original || s.phone_normalized || '—' %></td>
            <td><%= tgname || '—' %></td>
            <td><%= s.sd_agent_name || (s.crm_agent_id || '—') %></td>
            <td><%= s.role || '—' %></td>
            <td><span class="tag <%= tagcls %>"><%= st %></span></td>
            <td>
              <% if (st !== 'confirmed') { %>
                <form method="POST" action="/tgbot/staff/confirm" class="rowform">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <select name="role">
                    <option value="agent">Агент</option>
                    <option value="head_of_sales">Руководитель продаж</option>
                    <option value="logistics">Логистика (руководитель)</option>
                    <option value="expeditor">Экспедитор (водитель)</option>
                    <option value="marketing">Маркетинг</option>
                    <option value="admin">Админ</option>
                  </select>
                  <select name="crm_agent_id">
                    <option value="">— агент CRM —</option>
                    <% agents.forEach(function(a){ %>
                      <option value="<%= a.sd_agent_id %>" <%= s.crm_agent_id===a.sd_agent_id?'selected':'' %>><%= a.sd_agent_name %><%= a.sd_agent_code ? ' / '+a.sd_agent_code : '' %></option>
                    <% }); %>
                  </select>
                  <select name="expeditor_sd_id">
                    <option value="">— экспедитор SD —</option>
                    <% (typeof expeditors!=='undefined'?expeditors:[]).forEach(function(e){ %>
                      <option value="<%= e.sd_id %>" <%= s.expeditor_sd_id===e.sd_id?'selected':'' %>><%= e.name %><%= e.phone_normalized ? ' · '+e.phone_normalized : '' %></option>
                    <% }); %>
                  </select>
                  <button class="btn-sm" type="submit">Подтвердить</button>
                </form>
                <form method="POST" action="/tgbot/staff/reject" style="margin-top:6px">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <button class="btn-sm danger" type="submit">Отклонить</button>
                </form>
              <% } else { %>
                <form method="POST" action="/tgbot/staff/role" class="rowform">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <select name="role">
                    <option value="agent" <%= s.role==='agent'?'selected':'' %>>Агент</option>
                    <option value="head_of_sales" <%= s.role==='head_of_sales'?'selected':'' %>>Руководитель продаж</option>
                    <option value="logistics" <%= s.role==='logistics'?'selected':'' %>>Логистика (руководитель)</option>
                    <option value="expeditor" <%= s.role==='expeditor'?'selected':'' %>>Экспедитор (водитель)</option>
                    <option value="marketing" <%= s.role==='marketing'?'selected':'' %>>Маркетинг</option>
                    <option value="admin" <%= s.role==='admin'?'selected':'' %>>Админ</option>
                  </select>
                  <button class="btn-sm" type="submit">Изменить роль</button>
                </form>
                <form method="POST" action="/tgbot/staff/disable" style="margin-top:6px">
                  <input type="hidden" name="id" value="<%= s.id %>">
                  <button class="btn-sm danger" type="submit">Отключить</button>
                </form>
              <% } %>
            </td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
  </main>
  <script src="/static/bell.js?v=<%= V %>"></script>
  <script src="/static/conn.js?v=<%= V %>"></script>
</body>
</html>
