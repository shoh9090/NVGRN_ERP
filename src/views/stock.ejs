<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Склад сырья — <%= settings.company_name %></title>
  <link rel="stylesheet" href="/static/style.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/dicts.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/purchase.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/stock.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/tabs.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/filters.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/chips.css?v=<%= V %>">
  <link rel="stylesheet" href="/static/conn.css?v=<%= V %>">
  <style>:root { --brand: <%= settings.brand_color || '#2E7D32' %>; }</style>
</head>
<body class="admin-body pur-body">
  <%- include('partials/topbar', { title: '📦 Склад сырья' }) %>

  <%
    // Доступ по вкладкам: null — все. Решает сервер, шаблон только не рисует лишнее.
    var okTabs = (typeof allowedTabs === 'undefined' || allowedTabs === null) ? null : allowedTabs;
    var tabOk = function (c) { return okTabs === null || okTabs.indexOf(c) >= 0; };
  %>
  <nav class="pur-tabs">
<% if (tabOk('receiving')) { %>    <a href="#receiving" data-tab="receiving" class="pur-tab">📥 Приёмка сегодня</a><% } %>
<% if (tabOk('issue')) { %>    <a href="#issue" data-tab="issue" class="pur-tab">📤 Остатки и передача</a><% } %>
<% if (tabOk('inventory')) { %>    <a href="#inventory" data-tab="inventory" class="pur-tab">📋 Резюме / Остатки</a><% } %>
<% if (tabOk('summary')) { %>    <a href="#summary" data-tab="summary" class="pur-tab">📊 Итоги дня</a><% } %>
  </nav>

  <main class="pur-main" id="stk-main"></main>
  <div id="stk-modal-root"></div>

  <script>window.HUB_USER = { isAdmin: <%= user.isAdmin ? "true" : "false" %>, name: "<%= user.name %>" };</script>
  <script src="/static/conn.js?v=<%= V %>"></script>
  <script src="/static/bell.js?v=<%= V %>"></script>
  <script src="/static/stock.js?v=<%= V %>"></script>
</body>
</html>
