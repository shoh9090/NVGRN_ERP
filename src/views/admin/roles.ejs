<%- include('_header') %>

<h2>Роли</h2>
<p class="muted">Роль определяет, какие плитки видит сотрудник. Один человек может иметь несколько ролей.</p>

<section class="card">
  <h3>Создать роль</h3>
  <form method="POST" action="/admin/roles" class="form-row">
    <input name="name" placeholder="Например: Бухгалтер, Производственник, Продажник" required>
    <button type="submit" class="btn-primary">Создать</button>
  </form>
</section>

<% roles.forEach(function(r) { %>
  <section class="card">
    <h3><%= r.name %> <% if (r.is_admin) { %><span class="badge">админ — видит всё</span><% } %><% if (r.is_finance) { %> <span class="badge" style="background:#e8f5e9;color:#2e7d32">финансы — ведёт Кассу/Обязательства</span><% } %></h3>
    <% if (!r.is_admin) { %>
      <form method="POST" action="/admin/roles/<%= r.id %>/finance" style="margin-bottom:8px">
        <label class="check"><input type="checkbox" name="is_finance" onchange="this.form.submit()" <%= r.is_finance ? 'checked' : '' %>> Роль «Финансы/Бухгалтерия» — может вести Кассу и Обязательства (вносить, править, проводить оплаты) без полного админа</label>
      </form>
      <form method="POST" action="/admin/roles/<%= r.id %>/tiles" class="checks">
        <% tiles.forEach(function(t) { %>
          <% var checked = roleTiles.some(function(x){ return x.role_id === r.id && x.tile_id === t.id; }); %>
          <label class="check">
            <input type="checkbox" name="tile_ids" value="<%= t.id %>" <%= checked ? 'checked' : '' %>>
            <%= t.icon %> <%= t.title %>
          </label>
          <%
            // Вкладки есть не у всех плиток: показываем их там, где доступ к вкладке
            // реально проверяется на сервере. Иначе галочка ничего бы не значила.
            var myTabs = (tileTabs || []).filter(function(x){ return x.tile_url === t.url; });
            var onTabs = myTabs.filter(function(x){ return (roleTabs || []).some(function(y){ return y.role_id === r.id && y.tab_id === x.id; }); });
          %>
          <% if (myTabs.length) { %>
            <details class="tabs-box" <%= onTabs.length ? 'open' : '' %>>
              <summary><%= onTabs.length ? ('Вкладки — отмечено ' + onTabs.length + ' из ' + myTabs.length) : 'Все вкладки — настроить' %></summary>
              <div class="tabs-grid">
                <% myTabs.forEach(function(tab) { %>
                  <% var tabOn = onTabs.some(function(x){ return x.id === tab.id; }); %>
                  <label class="check">
                    <input type="checkbox" name="tab_ids" value="<%= tab.id %>" <%= tabOn ? 'checked' : '' %>>
                    <%= tab.name %>
                  </label>
                <% }) %>
              </div>
              <p class="muted tabs-note">Не отмечено ни одной вкладки — доступны все. Отметили хотя бы одну — видны только отмеченные.</p>
            </details>
          <% } %>
        <% }) %>
        <button type="submit">Сохранить доступ</button>
      </form>
      <form method="POST" action="/admin/roles/<%= r.id %>/delete" onsubmit="return confirm('Удалить роль «<%= r.name %>»?')">
        <button type="submit" class="btn-danger-link">Удалить роль</button>
      </form>
    <% } %>
  </section>
<% }) %>

<%- include('_footer') %>
