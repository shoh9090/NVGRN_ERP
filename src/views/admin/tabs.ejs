<%- include('_header') %>

<h2>Доступ по вкладкам</h2>
<p class="muted">
  Разрез уже выданного доступа: у каждой роли показаны только её плитки. Плитка открывает раздел целиком,
  а здесь можно оставить внутри него лишь нужные вкладки.
  <br>
  <b>Не отмечено ни одной — доступны все.</b> Отметили хотя бы одну — видны <b>только отмеченные</b>
  (отметка не добавляет вкладку к остальным, а оставляет её одну).
  <br>
  Плитки без вкладок — Счета-фактуры, Справочники, бот — здесь не показываются: ограничивать в них нечего.
</p>

<% if (!groups.length) { %>
  <section class="card">
    <p class="muted">Пока ни одна плитка не заведена для доступа по вкладкам. Вкладки появляются здесь только после того, как их проверка встроена на сервере — галочка, которая ничего не закрывает, хуже её отсутствия.</p>
  </section>
<% } else { %>
  <% roles.forEach(function(r) { %>
    <section class="card">
      <h3><%= r.name %><% if (r.is_admin) { %> <span class="badge">админ — видит всё</span><% } %></h3>
      <% if (r.is_admin) { %>
        <p class="muted">Администратор видит все вкладки всегда — ограничить его нельзя.</p>
      <% } else { %>
        <%
          // Показываем только плитки, которые роли ВЫДАНЫ. Раньше здесь был
          // общий список всех плиток с припиской «плитка роли не выдана» —
          // получались простыни, которые приходилось проматывать.
          // Плитки без вкладок (Счета-фактуры, Справочники, бот) сюда не
          // попадают вовсе: ограничивать в них нечего.
          var mine = groups.filter(function(g){
            return roleTiles.some(function(x){ return x.role_id === r.id && x.tile_id === g.tile_id; });
          });
        %>
        <% if (!mine.length) { %>
          <p class="muted">Роли не выдано ни одной плитки с вкладками — настраивать нечего. Плитки выдаются в разделе «Роли».</p>
        <% } else { %>
          <form method="POST" action="/admin/tabs/<%= r.id %>">
            <% mine.forEach(function(g) { %>
              <%
                var onCount = g.tabs.filter(function(tab){
                  return roleTabs.some(function(y){ return y.role_id === r.id && y.tab_id === tab.id; });
                }).length;
              %>
              <div class="tabs-box-static">
                <div class="tabs-title">
                  <%= g.tile_title %>
                  <span class="muted"> — <%= onCount ? ('видны только отмеченные: ' + onCount + ' из ' + g.tabs.length) : 'доступны все вкладки' %></span>
                </div>
                <div class="tabs-grid">
                  <% g.tabs.forEach(function(tab) { %>
                    <% var on = roleTabs.some(function(y){ return y.role_id === r.id && y.tab_id === tab.id; }); %>
                    <label class="check">
                      <input type="checkbox" name="tab_ids" value="<%= tab.id %>" <%= on ? 'checked' : '' %>>
                      <%= tab.name %>
                    </label>
                  <% }) %>
                </div>
              </div>
            <% }) %>
            <button type="submit">Сохранить вкладки</button>
          </form>
        <% } %>
      <% } %>
    </section>
  <% }) %>
<% } %>

<%- include('_footer') %>
