<%- include('_header') %>
<%#
  Предпросмотр переноса Telegram-сотрудников бота в пользователи ERP.
  Шаг 3 плана docs/plan-single-user-list.md — страница НИЧЕГО не записывает.
%>
<h2>Перенос сотрудников бота в пользователи ERP — предпросмотр</h2>
<p class="muted" style="margin:6px 0 14px;max-width:900px">
  Здесь показано, что произойдёт при переносе. <strong>Сейчас ничего не записывается.</strong>
  Связь с Telegram у людей не меняется, переподключаться никому не нужно.
  Конфликты нужно решить до переноса — в плитке бота («Telegram-сотрудники») или здесь, в пользователях.
</p>

<section class="card">
  <h3>Свяжем с существующим пользователем — <%= plan.link.length %></h3>
  <% if (!plan.link.length) { %><p class="muted">Нет.</p><% } else { %>
  <table><thead><tr><th>В боте</th><th>Роль в боте</th><th>Телефон</th><th>→ Пользователь ERP</th><th>Веб</th></tr></thead><tbody>
    <% plan.link.forEach(function(x){ %><tr><td><%= x.name %></td><td><%= roleLabel(x.role) %></td><td>+998<%= x.phone %></td><td><%= x.user_name %></td><td><%= x.web_access ? 'есть' : 'нет' %></td></tr><% }) %>
  </tbody></table><% } %>
</section>

<section class="card">
  <h3>Создадим пользователя — <%= plan.create.length %></h3>
  <p class="muted">Без доступа в веб-версию. Руководителям (РОП, логистика) веб при необходимости включите после переноса.</p>
  <% if (!plan.create.length) { %><p class="muted">Нет.</p><% } else { %>
  <table><thead><tr><th>Имя</th><th>Роль в боте</th><th>Телефон</th><th>Логин</th></tr></thead><tbody>
    <% plan.create.forEach(function(x){ %><tr><td><%= x.name %><% if (x.managerRole) { %> <span class="muted">(руководитель — проверьте, нужен ли веб)</span><% } %></td><td><%= roleLabel(x.role) %></td><td>+998<%= x.phone %></td><td><%= x.suggestLogin %></td></tr><% }) %>
  </tbody></table><% } %>
</section>

<section class="card">
  <h3 style="color:#c0392b">Конфликты — <%= plan.conflicts.length %></h3>
  <p class="muted">Эти люди не будут перенесены, пока конфликт не решён.</p>
  <% if (!plan.conflicts.length) { %><p style="color:#2e7d32;font-weight:700">Конфликтов нет.</p><% } else { %>
  <table><thead><tr><th>В боте</th><th>Роль в боте</th><th>Телефон</th><th>В чём дело</th></tr></thead><tbody>
    <% plan.conflicts.forEach(function(x){ %><tr><td><%= x.name %></td><td><%= roleLabel(x.role) %></td><td><%= x.phone ? '+998' + x.phone : '—' %></td><td><%= x.why %><% if (x.user_name) { %> (пользователь: <%= x.user_name %>)<% } %></td></tr><% }) %>
  </tbody></table><% } %>
</section>

<p class="muted">Не переносятся (заявки, отклонённые, отключённые в боте): <%= plan.skipped %>.</p>
<p><a class="btn-ghost" href="/admin/users">← К пользователям</a></p>
<%- include('_footer') %>
