<%- include('_header') %>

<h2>Справочники</h2>
<p class="muted">Общие данные для всех блоков: контрагенты, номенклатура, единицы измерения. Все модули используют эти справочники — без дублей.</p>

<section class="card">
  <h3>Контрагенты</h3>
  <form method="POST" action="/admin/dictionaries/counterparty" class="form-row">
    <input name="name" placeholder="Название (ООО «Рассвет»)" required>
    <input name="inn" placeholder="ИНН (необязательно)">
    <button type="submit" class="btn-primary">Добавить</button>
  </form>
  <table>
    <thead><tr><th>Название</th><th>ИНН</th></tr></thead>
    <tbody>
      <% counterparties.forEach(function(c) { %>
        <tr><td><%= c.name %></td><td><%= c.inn || '—' %></td></tr>
      <% }) %>
    </tbody>
  </table>
</section>

<section class="card">
  <h3>Номенклатура (товары)</h3>
  <form method="POST" action="/admin/dictionaries/product" class="form-row">
    <input name="name" placeholder="Например: Рукола 125 г" required>
    <select name="unit_id">
      <option value="">— единица —</option>
      <% units.forEach(function(u) { %>
        <option value="<%= u.id %>"><%= u.short_name %></option>
      <% }) %>
    </select>
    <button type="submit" class="btn-primary">Добавить</button>
  </form>
  <table>
    <thead><tr><th>Название</th><th>Ед.</th></tr></thead>
    <tbody>
      <% products.forEach(function(p) { %>
        <tr><td><%= p.name %></td><td><%= p.short_name || '—' %></td></tr>
      <% }) %>
    </tbody>
  </table>
</section>

<section class="card">
  <h3>Единицы измерения</h3>
  <form method="POST" action="/admin/dictionaries/unit" class="form-row">
    <input name="name" placeholder="Название (Килограмм)" required>
    <input name="short_name" placeholder="Сокращение (кг)" required style="max-width:160px">
    <button type="submit" class="btn-primary">Добавить</button>
  </form>
  <table>
    <thead><tr><th>Название</th><th>Сокращение</th></tr></thead>
    <tbody>
      <% units.forEach(function(u) { %>
        <tr><td><%= u.name %></td><td><%= u.short_name %></td></tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('_footer') %>
