<%- include('_header') %>

<h2>Пользователи</h2>

<% if (msg === 'self_admin') { %>
  <p class="error">Нельзя снять полный доступ с самого себя — иначе вы потеряете доступ к админке. Попросите другого администратора.</p>
<% } else if (msg === 'last_admin') { %>
  <p class="error">Нельзя убрать последнего администратора — в системе должен остаться хотя бы один. Сначала выдайте полный доступ другому пользователю.</p>
<% } else if (msg === 'roles_saved') { %>
  <p style="color:#2e7d32;font-weight:700">Роли сохранены.</p>
<% } else if (msg === 'user_deleted') { %>
  <p style="color:#2e7d32;font-weight:700">Пользователь удалён.</p>
<% } else if (msg === 'self_delete') { %>
  <p class="error">Нельзя удалить самого себя.</p>
<% } %>

<p class="muted" style="margin:6px 0 14px">
  Роль <strong>«Администратор» = полный доступ</strong>: все плитки и все действия, как у владельца.
  Отметьте её у пользователя — и он увидит систему так же, как вы.
</p>

<section class="card">
  <h3>Добавить пользователя</h3>
  <form method="POST" action="/admin/users" class="form-row">
    <input name="full_name" placeholder="Имя и фамилия" required>
    <input name="login" placeholder="Логин" required>
    <input name="password" type="text" placeholder="Пароль (мин. 6)" minlength="6" required>
    <fieldset class="checks">
      <legend>Роли:</legend>
      <% roles.forEach(function(r) { %>
        <label class="check"><input type="checkbox" name="role_ids" value="<%= r.id %>"> <%= r.name %><% if (r.is_admin) { %> <strong>(полный доступ)</strong><% } %></label>
      <% }) %>
    </fieldset>
    <button type="submit" class="btn-primary">Создать</button>
  </form>
</section>

<section class="card">
  <table>
    <thead>
      <tr><th>Имя</th><th>Логин</th><th>Роли</th><th>Статус</th><th>Действия</th></tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr class="<%= u.is_active ? '' : 'row-inactive' %>">
          <td><%= u.full_name %></td>
          <td><%= u.login %></td>
          <td>
            <details>
              <summary><%= u.role_names %><% if (u.is_admin) { %> 👑<% } %></summary>
              <form method="POST" action="/admin/users/<%= u.id %>/roles" class="checks">
                <% roles.forEach(function(r) { %>
                  <label class="check">
                    <input type="checkbox" name="role_ids" value="<%= r.id %>" <%= (u.role_ids || []).indexOf(r.id) !== -1 ? 'checked' : '' %>>
                    <%= r.name %><% if (r.is_admin) { %> <strong>(полный доступ)</strong><% } %>
                  </label>
                <% }) %>
                <button type="submit">Сохранить роли</button>
              </form>
            </details>
          </td>
          <td><%= u.is_active ? 'Активен' : 'Отключён' %></td>
          <td class="actions">
            <form method="POST" action="/admin/users/<%= u.id %>/toggle">
              <button type="submit"><%= u.is_active ? 'Отключить' : 'Включить' %></button>
            </form>
            <details>
              <summary>Сбросить пароль</summary>
              <form method="POST" action="/admin/users/<%= u.id %>/password" class="inline-form">
                <input name="password" type="text" placeholder="Новый пароль" minlength="6" required>
                <button type="submit">Сохранить</button>
              </form>
            </details>
            <% if (u.id !== user.id) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/delete"
                    onsubmit="return confirm('Удалить пользователя «<%= u.full_name %>» навсегда? Это действие нельзя отменить. Если у человека есть история операций — лучше «Отключить».');">
                <button type="submit" class="btn-danger-link" style="color:#c0392b">Удалить</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('_footer') %>
