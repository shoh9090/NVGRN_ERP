<%- include('_header') %>
<style>
  /* Поле телефона в строке таблицы: форма растягивала его по остатку узкой
     колонки, и номер не помещался. Даём полю ширину под номер целиком. */
  .tg-phone-form { flex-wrap: nowrap; align-items: center; }
  .tg-phone-form input { width: 190px; min-width: 190px; flex: none; }
  .tg-phone-form button { flex: none; }
</style>

<h2>Пользователи</h2>

<% if (msg === 'self_admin') { %>
  <p class="error">Нельзя снять полный доступ с самого себя — иначе вы потеряете доступ к админке. Попросите другого администратора.</p>
<% } else if (msg === 'last_admin') { %>
  <p class="error">Нельзя убрать последнего администратора — в системе должен остаться хотя бы один. Сначала выдайте полный доступ другому пользователю.</p>
<% } else if (msg === 'roles_saved') { %>
  <p style="color:#2e7d32;font-weight:700">Роли сохранены.</p>
<% } else if (msg === 'user_deleted') { %>
  <p style="color:#2e7d32;font-weight:700">Пользователь удалён.</p>
<% } else if (msg === 'self_delete') { %>
  <p class="error">Нельзя удалить самого себя.</p>
<% } else if (msg === 'bot_saved') { %>
  <p style="color:#2e7d32;font-weight:700">Сохранено.</p>
<% } else if (msg === 'need_password') { %>
  <p class="error">Укажите имя, логин и пароль — они нужны каждому пользователю.</p>
<% } else if (msg === 'phone_saved') { %>
  <p style="color:#2e7d32;font-weight:700">Телефон сохранён.</p>
<% } else if (msg === 'phone_taken') { %>
  <p class="error">Этот номер уже указан у другого пользователя. Один номер — один человек, иначе бот не поймёт, кто ему пишет.</p>
<% } else if (msg === 'phone_bad') { %>
  <p class="error">Номер слишком короткий. Укажите полностью, например +998 90 123 45 67.</p>
<% } %>

<p class="muted" style="margin:6px 0 14px">
  Роль <strong>«Администратор» = полный доступ</strong>: все плитки и все действия, как у владельца.
  Отметьте её у пользователя — и он увидит систему так же, как вы.
</p>
<p class="muted" style="margin:0 0 14px">
  <strong>Телефон (Telegram)</strong> нужен тем, кому бот пишет лично (например, руководителям звеньев по претензиям).
  После того как номер указан, сотрудник открывает бота и нажимает «Поделиться номером» — рядом с телефоном появится «в боте ✓».
</p>

<section class="card">
  <h3>Добавить пользователя</h3>
  <form method="POST" action="/admin/users" class="form-row">
    <input name="full_name" placeholder="Имя и фамилия" required>
    <input name="login" placeholder="Логин" required>
    <input name="password" type="text" placeholder="Пароль (мин. 6)" minlength="6" required>
    <input name="tg_phone" type="tel" placeholder="Телефон в Telegram (необязательно)" title="По этому номеру бот узнает сотрудника и будет присылать ему претензии по его зоне">
    <fieldset class="checks">
      <legend>Роли:</legend>
      <% roles.forEach(function(r) { %>
        <label class="check"><input type="checkbox" name="role_ids" value="<%= r.id %>"> <%= r.name %><% if (r.is_admin) { %> <strong>(полный доступ)</strong><% } %></label>
      <% }) %>
    </fieldset>
    <button type="submit" class="btn-primary">Создать</button>
  </form>
</section>

<section class="card">
  <table>
    <thead>
      <tr><th>Имя</th><th>Логин</th><th>Роли</th><th title="По этому номеру бот узнаёт сотрудника">Телефон (Telegram)</th><th title="Для руководителей: какие сводки бот присылает по телефону из карточки">Роль в боте</th><th>Статус</th><th>Действия</th></tr>
    </thead>
    <tbody>
      <% users.forEach(function(u) { %>
        <tr class="<%= u.is_active ? '' : 'row-inactive' %>">
          <td><%= u.full_name %></td>
          <td><%= u.login %></td>
          <td>
            <details>
              <summary><%= u.role_names %><% if (u.is_admin) { %> 👑<% } %></summary>
              <form method="POST" action="/admin/users/<%= u.id %>/roles" class="checks">
                <% roles.forEach(function(r) { %>
                  <label class="check">
                    <input type="checkbox" name="role_ids" value="<%= r.id %>" <%= (u.role_ids || []).indexOf(r.id) !== -1 ? 'checked' : '' %>>
                    <%= r.name %><% if (r.is_admin) { %> <strong>(полный доступ)</strong><% } %>
                  </label>
                <% }) %>
                <button type="submit">Сохранить роли</button>
              </form>
            </details>
          </td>
          <td>
            <details>
              <summary><%= u.tg_phone ? ((u.tg_phone.length === 9 ? '+998' : '+') + u.tg_phone) : '—' %><% if (u.tg_phone) { %>
                <% if (u.tg_chat_id) { %><span title="Сотрудник открыл бота и поделился номером — бот может ему писать" style="color:#2e7d32;font-weight:700"> · в боте ✓</span><% } else { %><span title="Бот не может написать первым: сотруднику нужно открыть бота и нажать «Поделиться номером»" style="color:#b25b00;font-weight:700"> · ждём в боте</span><% } %><% } %></summary>
              <form method="POST" action="/admin/users/<%= u.id %>/phone" class="inline-form tg-phone-form">
                <input name="tg_phone" type="tel" value="<%= u.tg_phone ? ((u.tg_phone.length === 9 ? '+998' : '+') + u.tg_phone) : '' %>" placeholder="+998 90 123 45 67" autocomplete="off">
                <button type="submit">Сохранить</button>
              </form>
            </details>
          </td>
          <td>
            <% var br = (BOT_ROLES || []).find(function(r){ return r.code && r.code === u.bot_role; }); %>
            <form method="POST" action="/admin/users/<%= u.id %>/bot" class="inline-form">
              <select name="bot_role" onchange="this.form.submit()" title="Руководителю бот присылает сводки его роли. Агенты и водители — в плитке бота.">
                <% (BOT_ROLES || []).forEach(function(r){ %><option value="<%= r.code %>" <%= (u.bot_role || '') === r.code ? 'selected' : '' %>><%= r.label %></option><% }) %>
              </select>
            </form>
          </td>
          <td><%= u.is_active ? 'Активен' : 'Отключён' %></td>
          <td class="actions">
            <form method="POST" action="/admin/users/<%= u.id %>/toggle">
              <button type="submit"><%= u.is_active ? 'Отключить' : 'Включить' %></button>
            </form>
            <details>
              <summary>Сбросить пароль</summary>
              <form method="POST" action="/admin/users/<%= u.id %>/password" class="inline-form">
                <input name="password" type="text" placeholder="Новый пароль" minlength="6" required>
                <button type="submit">Сохранить</button>
              </form>
            </details>
            <% if (u.id !== user.id) { %>
              <form method="POST" action="/admin/users/<%= u.id %>/delete"
                    onsubmit="return confirm('Удалить пользователя «<%= u.full_name %>» навсегда? Это действие нельзя отменить. Если у человека есть история операций — лучше «Отключить».');">
                <button type="submit" class="btn-danger-link" style="color:#c0392b">Удалить</button>
              </form>
            <% } %>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('_footer') %>
