<%- include('_header') %>

<h2>Интеграции</h2>
<p class="muted">Подключение внешних систем. Данные доступа хранятся в зашифрованном виде и не отображаются после сохранения.</p>

<section class="card">
  <h3>SalesDoctor <% if (sd.lastTest && sd.lastTest.startsWith('OK')) { %><span class="badge">подключено</span><% } %></h3>

  <% if (message) { %><div class="<%= messageType === 'error' ? 'error' : 'badge' %>" style="display:block; margin-bottom:12px; padding:11px 14px; border-radius:12px;"><%= message %></div><% } %>

  <form method="POST" action="/admin/integrations/sd" class="form-col">
    <label>Адрес сервера
      <input name="url" value="<%= sd.url %>" placeholder="novagreen.salesdoc.io" required>
    </label>
    <label>Логин API-пользователя
      <input name="login" value="<%= sd.login %>" placeholder="sd_user" required>
    </label>
    <label>Пароль <%= sd.hasPassword ? '(сохранён — оставьте пустым, чтобы не менять)' : '' %>
      <input name="password" type="password" placeholder="<%= sd.hasPassword ? '••••••••' : 'пароль' %>" <%= sd.hasPassword ? '' : 'required' %>>
    </label>
    <div class="actions" style="margin-top:4px">
      <button type="submit" class="btn-primary">Сохранить</button>
      <button type="submit" formaction="/admin/integrations/sd/test">Проверить подключение</button>
      <a href="/admin/integrations/sd/diag" target="_blank" class="btn-ghost" style="color:var(--ink-soft); border:1px solid var(--line)">Диагностика</a>
    </div>
  </form>

  <div style="margin-top:16px">
    <% if (sd.lastTest) { %><p class="muted">Последняя проверка: <%= sd.lastTest %></p><% } %>
    <% if (sd.lastSync) { %><p class="muted">Последняя синхронизация ГП: <%= sd.lastSync %></p><% } %>
    <p class="muted">Кнопка синхронизации находится в модуле «Справочники» → «Готовая продукция».</p>
  </div>
</section>

<section class="card" style="border-color:#e8c7bd">
  <h3 style="color:var(--red)">Опасная зона: очистка справочников</h3>
  <p class="muted">Полностью удаляет все записи справочников (сырьё, ГП, упаковку, контрагентов, культуры, цены и пр.) и восстанавливает базовые категории с кодами. Пользователи, роли, плитки и настройки не затрагиваются. Перед очисткой выгрузите нужные справочники через «Экспорт».</p>
  <form method="POST" action="/admin/maintenance/wipe-dictionaries" class="form-row"
        onsubmit="return confirm('Все данные справочников будут удалены безвозвратно. Продолжить?')">
    <input name="confirm" placeholder="Введите слово ОЧИСТИТЬ" required style="max-width:260px">
    <button type="submit" class="btn-danger-link" style="text-decoration:none;border:1px solid #e8c7bd;border-radius:11px;padding:9px 18px">Очистить все справочники</button>
  </form>
</section>

<%- include('_footer') %>
